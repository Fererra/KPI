@startuml
actor User
participant UI
participant PaymentGateway as PG
participant PaymentService as PS
participant BookingService as BS
participant SeatsService as SS
database DB

User -> UI : 1. Click "Pay now"
activate UI
UI -> User : 2. Redirect to payment page
activate PG
User -> PG : 3. Enter payment details and confirm
PG -> PG : 4. Process transaction 
PG -> PS : 5. sendPaymentCallback(bookingId, transactionId, status)
activate PS

PS -> PS : 6. verifyPayment(transactionId)

alt payment success
    PS -> BS : 7.1. updateBookingStatus(bookingId, "PAID")
    activate BS
    BS -> DB : 8.1. setBookingStatus(bookingId, "PAID")
    DB --> BS : 9.1. ok
    BS --> PS : 10.1. booking confirmed
    deactivate BS
else payment failed or expired
    PS -> BS : 7.2. cancelBooking(bookingId)
    activate BS
    BS -> SS : 8.2. releaseSeats(bookingId)
    activate SS
    SS -> DB : 9.2. releaseSeats(bookingId)
    DB --> SS : 10.2. ok
    SS --> BS : 11.2. ok
    deactivate SS
    BS -> DB : 12.2. setBookingStatus(bookingId, "CANCELLED")
    DB --> BS : 13.2. ok
    BS --> PS : 14.2. booking cancelled
    deactivate PS
    deactivate BS
end

PG -> UI : 15. Redirect with status (success / fail)
deactivate PG
UI -> User : 16. displayPaymentResult(info)
deactivate UI
@enduml
